# NPR 초등부 업무일지 — 환경변수 예시
# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋하지 않는다.
# 각 변수의 설명은 docs/operations.md 참고.

# ── 앱 ────────────────────────────────────────────────
PORT=3000

# 앱 기준 '오늘'. 비워두면 한국시간(KST) 실제 날짜를 쓴다.
# 데모 데이터(2026년 7월 둘째 주)를 그대로 보려면 그 주의 평일(예: 2026-07-10)로 고정한다.
APP_TODAY=

# 강사별 외부 ERP 비밀번호 암호화와 반 목록 확인 정보 서명에 쓰는 서버 비밀값.
# 운영(next start)에서는 필수. 개발에서 비워두면 프로세스마다 임의 키를 만든다.
# 한 번 정하면 바꾸지 말 것(바꾸면 저장된 ERP 비밀번호를 복호화할 수 없다).
APP_SECRET=

# 초기 데이터 모드: clean = 팀장 계정과 기본 태그만(기본) | demo = 데모 데이터 시드
SEED_MODE=demo

# ── 마스터 팀장 계정(clean 모드) ───────────────────────
LEAD_ID=admin
LEAD_PW=
LEAD_NAME=팀장

# ── DB (libSQL / Turso) ───────────────────────────────
# 지정하면 Turso 임베디드 리플리카 + 원격 동기화. 비워두면 로컬 파일 DB(data/app.sqlite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 외부 ERP(통통통)는 모의 구현(src/ttt/ttt.mock.ts)만 들어 있어 별도 설정이 필요 없다.
